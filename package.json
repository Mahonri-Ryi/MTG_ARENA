{
  "name": "mtg-arena-coach",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An MTG Arena overlay and companion (desktop + Android) that coaches drafting and best plays, inspired by untapped.gg.",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.3",
  "scripts": {
    "lint": "eslint .",
    "test": "pnpm -r --if-present test",
    "build": "pnpm -r --if-present build",
    "dev:desktop": "pnpm --filter @mtg-coach/desktop dev",
    "dev:mobile": "pnpm --filter @mtg-coach/mobile web"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "electron"
    ]
  }
}

{
  "name": "@mtg-coach/core",
  "version": "0.1.0",
  "description": "Shared, platform-agnostic core: MTGA log parsing, Scryfall card data, and draft ranking.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./node": {
      "types": "./src/node/index.ts",
      "import": "./src/node/index.ts"
    }
  },
  "files": [
    "dist",
    "src",
    "data"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  }
}
